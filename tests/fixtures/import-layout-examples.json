    "name": "Reporte de notas",
    "code": "// Codigo generado desde FlowCode\n\nasync function calcularPromedio(notas) {\n  let suma = 0;\n  for (let i = 0; i < notas.length; i++) {\n    suma += notas[i];\n  }\n  return suma / notas.length;\n}\n\nasync function clasificarPromedio(promedio) {\n  if (promedio >= 6) {\n    return \"excelente\";\n  } else {\n    if (promedio >= 4) {\n      return \"aprueba\";\n    } else {\n      return \"riesgo\";\n    }\n  }\n}\n\nasync function main() {\n  let notas = [5, 6, 4, 7];\n  let promedio;\n  promedio = await calcularPromedio(notas);\n  let categoria;\n  categoria = await clasificarPromedio(promedio);\n  switch (categoria) {\n    case \"excelente\":\n      console.log(\"Promedio \" + promedio + \": felicitar\");\n      break;\n    case \"aprueba\":\n      console.log(\"Promedio \" + promedio + \": reforzar\");\n      break;\n    default:\n      console.log(\"Promedio \" + promedio + \": plan de apoyo\");\n  }\n  // Fin del programa.\n}\n\nmain();",
