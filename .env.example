MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=flowcode

FLOWCODE_BOOTSTRAP_ADMIN_USERNAME=admin
FLOWCODE_BOOTSTRAP_ADMIN_PASSWORD=replace-with-a-secure-password

APP_URL=http://localhost:3000
EMAIL_QUEUE_SECRET=replace-with-at-least-32-random-characters
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-smtp-user
SMTP_PASSWORD=your-smtp-password
SMTP_FROM=FlowCode <no-reply@example.com>

# Cloudflare Turnstile (vacío usa las claves oficiales de prueba solo en desarrollo)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Protege POST /api/cron/email-outbox si usas un cron externo
CRON_SECRET=replace-with-at-least-32-random-characters
EMAIL_WORKER_INTERVAL_MS=60000
